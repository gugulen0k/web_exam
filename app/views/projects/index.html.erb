<div class="max-w-7xl mx-auto">
  <!-- Hero Section -->
  <div class="text-center mb-12">
    <h1 class="text-5xl font-bold mb-4">
      <span class="text-white">{'</span>
      <span class="text-green-400">Портфолио студентов</span>
      <span class="text-white">'}</span>
    </h1>
    <p class="text-xl text-gray-400 font-sans">
      Коллекция лучших проектов наших разработчиков
    </p>
    <div class="mt-4 text-green-500">
      <span class="animate-pulse">▶</span> Запуск программы...
    </div>
  </div>

  <!-- Projects Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
    <% @projects.each do |project| %>
      <div class="bg-gray-800 border border-green-500/30 rounded-lg p-6 hover:border-green-500 transition-all duration-300 hover:shadow-lg hover:shadow-green-500/20">
        <!-- Project Image -->
        <div class="w-full h-48 bg-gray-700 rounded mb-4 overflow-hidden">
          <% if project.project_images.any? %>
            <%= image_tag project.project_images.first.image,
                class: "w-full h-full object-cover",
                alt: project.title %>
          <% else %>
            <div class="w-full h-full flex items-center justify-center text-gray-500">
              <div class="text-center">
                <div class="text-4xl mb-2">💻</div>
                <div class="text-sm">Нет изображения</div>
              </div>
            </div>
          <% end %>
        </div>

        <!-- Project Info -->
        <div class="space-y-3">
          <h3 class="text-xl font-semibold text-white">
            <span class="text-green-400">function</span> <%= project.title %>() <span class="text-white">{</span>
          </h3>

          <p class="text-gray-300 text-sm font-sans leading-relaxed">
            <%= truncate(project.description, length: 120) %>
          </p>

          <div class="text-sm text-gray-500">
            <span class="text-green-400">author:</span> "<%= project.author_name %>"
          </div>

          <!-- Technology Stack -->
          <% if project.technology_stack.present? %>
            <div class="flex flex-wrap gap-2">
              <% project.technology_stack.split(',').each do |tech| %>
                <span class="px-2 py-1 bg-green-900/30 text-green-300 text-xs rounded border border-green-700">
                  <%= tech.strip %>
                </span>
              <% end %>
            </div>
          <% end %>

          <!-- Action Button -->
          <div class="pt-4">
            <%= link_to project_path(project),
                class: "inline-block w-full text-center px-4 py-2 bg-green-600 text-white rounded hover:bg-green-700 transition-colors" do %>
              <span class="text-green-200">></span> Подробнее
            <% end %>
          </div>

          <!-- Admin Controls for Cards -->
          <% if current_user %>
            <div class="grid grid-cols-2 gap-2 pt-3">
              <%= link_to edit_project_path(project),
                  class: "flex gap-2 justify-center w-full px-3 py-2 bg-blue-600 text-white text-sm rounded hover:bg-blue-700 transition-colors" do %>
                <span>✏️</span>
                <span>Изменить</span>
              <% end %>
              <%= button_to project_path(project),
                  method: :delete,
                  data: {
                    confirm: "Удалить проект '#{project.title}'?",
                    turbo_method: :delete
                  },
                  class: "flex gap-2 justify-center w-full px-3 py-2 bg-red-600 text-white text-sm rounded hover:bg-red-700 transition-colors" do %>
                <span>🗑️</span>
                <span>Удалить</span>
              <% end %>
            </div>
          <% end %>
          <div class="text-gray-600 pt-2">
            <span class="text-white text-xl">}</span> // Created <%= project.created_at.strftime("%Y-%m-%d") %>
          </div>
        </div>
      </div>
    <% end %>
  </div>

  <% if @projects.empty? %>
    <div class="text-center py-20">
      <div class="text-6xl mb-4">🚀</div>
      <h2 class="text-2xl text-white mb-4">Проекты не найдены</h2>
      <p class="text-gray-400 mb-8">Пока что здесь пусто. Станьте первым, кто добавит проект!</p>
      <% if current_user %>
        <%= link_to new_project_path,
            class: "px-6 py-3 bg-green-600 text-white rounded-lg hover:bg-green-700 transition-colors" do %>
          Создать первый проект
        <% end %>
      <% end %>
    </div>
  <% end %>
</div>
