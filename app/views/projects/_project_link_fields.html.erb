<div data-nested-form-wrapper class="link-form-group bg-gray-700 border border-gray-600 rounded-lg p-4 relative">
  <%= form.hidden_field :_destroy %>

  <div class="grid grid-cols-1 md:grid-cols-12 gap-4 items-start">
    <!-- Link Type & Icon -->
    <div class="md:col-span-3">
      <%= form.label :link_type, class: "block text-sm text-gray-300 mb-1" do %>
        Тип ссылки
      <% end %>
      <div class="flex items-center space-x-2">
        <span class="icon-preview text-2xl">
          <%= form.object.display_icon if form.object %>
        </span>
        <%= form.select :link_type,
            options_for_select(ProjectLink::LINK_TYPES.keys.map { |type|
              [type.humanize, type]
            }, form.object&.link_type),
            { prompt: "Выберите тип" },
            {
              class: "flex-1 bg-gray-600 border border-gray-500 rounded px-3 py-2 text-white text-sm focus:border-green-500 focus:outline-none",
              data: { action: "change->nested-form#updateIcon" }
            } %>
      </div>
    </div>

    <!-- Title -->
    <div class="md:col-span-4">
      <%= form.label :title, class: "block text-sm text-gray-300 mb-1" do %>
        Название ссылки
      <% end %>
      <%= form.text_field :title,
          class: "w-full bg-gray-600 border border-gray-500 rounded px-3 py-2 text-white text-sm focus:border-green-500 focus:outline-none",
          placeholder: "Например: Исходный код" %>
    </div>

    <!-- URL -->
    <div class="md:col-span-4">
      <%= form.label :url, class: "block text-sm text-gray-300 mb-1" do %>
        URL
      <% end %>
      <%= form.url_field :url,
          class: "w-full bg-gray-600 border border-gray-500 rounded px-3 py-2 text-white text-sm focus:border-green-500 focus:outline-none",
          placeholder: "https://example.com" %>
    </div>

    <!-- Remove Button -->
    <div class="md:col-span-1 flex items-end">
      <button type="button"
              data-action="click->nested-form#remove"
              class="w-full p-2 bg-red-600 text-white rounded hover:bg-red-700 transition-colors text-sm"
              title="Удалить ссылку">
        🗑️
      </button>
    </div>
  </div>

  <!-- Custom Icon Field (показывается только для custom типа) -->
  <div class="mt-3" style="<%= 'display: none;' unless form.object&.link_type == 'custom' %>">
    <%= form.label :icon, class: "block text-sm text-gray-300 mb-1" do %>
      Кастомная иконка (emoji)
    <% end %>
    <%= form.text_field :icon,
        class: "w-full bg-gray-600 border border-gray-500 rounded px-3 py-2 text-white text-sm focus:border-green-500 focus:outline-none",
        placeholder: "🔗",
        maxlength: 2 %>
  </div>

  <%= form.hidden_field :position %>
</div>
