<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "DevPortfolio - Репозиторий проектов студентов" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <!-- Google Fonts for coding feel -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@300;400;500;600;700&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-gray-900 text-green-400 min-h-screen font-mono" data-turbo-permanent>
    <!-- Header -->
    <header class="border-b border-green-500/30 bg-gray-800/50 backdrop-blur">
      <div class="container mx-auto px-4 py-4">
        <nav class="flex justify-between items-center">
          <%= link_to root_path, class: "text-2xl font-bold text-green-400 hover:text-green-300 transition-colors" do %>
            <span class="text-white">&lt;</span>DevPortfolio<span class="text-white">/&gt;</span>
          <% end %>

          <div class="flex items-center space-x-4">
            <% if current_user %>
              <%= link_to new_project_path, class: "px-4 py-2 bg-green-600 text-white rounded hover:bg-green-700 transition-colors" do %>
                + Новый проект
              <% end %>
              <%= button_to logout_path,
                  method: :delete,
                  data: { turbo_method: :delete },
                  class: "px-4 py-2 border border-green-500 text-green-400 rounded hover:bg-green-500/10 transition-colors",
                  form: { style: "display: inline-block;" } do %>
                Выйти
              <% end %>
            <% else %>
              <%= link_to login_path, class: "px-4 py-2 border border-green-500 text-green-400 rounded hover:bg-green-500/10 transition-colors" do %>
                Войти
              <% end %>
            <% end %>
          </div>
        </nav>
      </div>
    </header>

    <!-- Flash messages -->
    <div id="flash-messages">
      <% if notice %>
        <div class="bg-green-900/50 border border-green-500 text-green-300 px-4 py-3 mx-4 mt-4 rounded">
          <span class="text-green-400">✓</span> <%= notice %>
        </div>
      <% end %>

      <% if alert %>
        <div class="bg-red-900/50 border border-red-500 text-red-300 px-4 py-3 mx-4 mt-4 rounded">
          <span class="text-red-400">✗</span> <%= alert %>
        </div>
      <% end %>
    </div>

    <!-- Main content -->
    <main class="container mx-auto px-4 py-8" id="main-content">
      <%= yield %>
    </main>

    <!-- Footer -->
    <footer class="border-t border-green-500/30 bg-gray-800/50 mt-20">
        <div class="container mx-auto px-4 py-6 text-center text-gray-500">
        <p>&copy; 2025 DevPortfolio. Made with <span class="text-red-500">♥</span> and <span class="text-green-400">code</span></p>
      </div>
    </footer>

    <script>
      document.addEventListener('DOMContentLoaded', function() {
        const flashMessages = document.querySelectorAll('#flash-messages > div');
        flashMessages.forEach(function(message) {
          setTimeout(function() {
            message.style.transition = 'opacity 0.5s ease-out';
            message.style.opacity = '0';
            setTimeout(function() {
              message.remove();
            }, 500);
          }, 5000);
        });
      });
    </script>
  </body>
</html>
